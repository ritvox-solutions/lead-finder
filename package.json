{
  "name": "leadfinder",
  "version": "2.0.0",
  "description": "Find local businesses without websites, build them a Next.js site, deploy to Vercel, and track replies. Dashboard hosted on Vercel; long-running agent runs on your laptop.",
  "main": "engine/index.ts",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cli": "node engine/index.ts",
    "agent": "tsx agent/index.ts",
    "agent:watch": "tsx watch agent/index.ts",
    "dev:all": "concurrently -k -n DASHBOARD,AGENT -c blue,green \"npm:dev\" \"npm:agent:watch\"",
    "agent-build": "tsc -p tsconfig.engine.json",
    "migrate:neon": "tsx scripts/migrate-sqlite-to-neon.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@octokit/rest": "^20.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "execa": "^10.0.1",
    "imapflow": "^1.6.6",
    "lucide-react": "^1.30.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "undici": "^8.10.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "better-sqlite3@13.0.3": true
  }
}
